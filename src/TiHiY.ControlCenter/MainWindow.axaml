<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TiHiY.ControlCenter.ViewModels"
        x:Class="TiHiY.ControlCenter.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="720"
        Title="TiHiY Control Center v0.1">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button Content="Open sample XML" Command="{Binding OpenSampleCommand}" />
      <Button Content="Backup" Command="{Binding BackupCommand}" />
      <Button Content="Apply TiHiY Defaults" Command="{Binding ApplyDefaultsCommand}" />
      <Button Content="Export XML to Desktop" Command="{Binding SaveExportCommand}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,*" Margin="0,16,0,0">
      <TextBlock Grid.ColumnSpan="2" Text="{Binding CurrentFile}" FontWeight="Bold" Margin="0,0,0,10" />
      <GroupBox Grid.Row="1" Grid.Column="0" Header="Axis options" Margin="0,0,8,0">
        <DataGrid ItemsSource="{Binding AxisOptions}" AutoGenerateColumns="True" IsReadOnly="False" />
      </GroupBox>
      <GroupBox Grid.Row="1" Grid.Column="1" Header="Bindings" Margin="8,0,0,0">
        <DataGrid ItemsSource="{Binding Bindings}" AutoGenerateColumns="True" IsReadOnly="True" />
      </GroupBox>
    </Grid>

    <Border Grid.Row="2" Padding="10" Margin="0,12,0,0" Background="#222222" CornerRadius="6">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
